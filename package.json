    "echarts": "6.1.0",
    "nuxt": "4.7.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.0",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.1",
    "vue-tsc": "^3.0.0"
